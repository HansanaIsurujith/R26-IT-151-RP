# Optional: relative to backend/Route-Optimization, or an absolute path.
ROUTING_NETWORK_PATH=network/gampaha_road_network_with_hazards.graphml

# Load the graph when the server starts (recommended for a smooth first request).
ROUTING_PRELOAD=1

# Precompute objective-linear and monotonic-fuzzy edge risks during startup.
ROUTING_PRECOMPUTE_RISK=1

# Reject selections farther than this from the Gampaha road network.
ROUTING_MAX_SNAP_DISTANCE_KM=15
ROUTING_HAZARD_DB_PATH=data/live_hazards.sqlite3
